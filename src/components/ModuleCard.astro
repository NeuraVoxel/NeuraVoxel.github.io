---
import type { ModuleEntry } from "../lib/content";
import { moduleSlug } from "../lib/content";
import type { Locale } from "../lib/locale";
import { href } from "../lib/locale";
import { useTranslations } from "../lib/i18n";

interface Props {
  locale: Locale;
  module: ModuleEntry;
  featured?: boolean;
}

const { locale, module: mod, featured = false } = Astro.props;
const t = useTranslations(locale);
const slug = moduleSlug(mod, locale);
const detailHref = href(locale, `/modules/${slug}`);

function statusClass(status: string) {
  if (status === "available") return "nv-badge--available";
  if (status === "preview") return "nv-badge--preview";
  return "nv-badge--planned";
}
---

<article
  class:list={[
    "product-card",
    "product-card--module",
    mod.data.role === "core" && "product-card--core",
    featured && "product-card--featured",
  ]}
>
  <a class="product-card__link" href={detailHref} aria-label={`${mod.data.title} — ${t("modules.viewModule")}`}></a>
  <div class="product-card__inner">
    <div class="product-card__body">
      <div class="product-card__badges">
        {mod.data.role === "core" && <span class="nv-badge nv-badge--core">{t("status.core")}</span>}
        <span class="nv-badge nv-badge--module">{t("status.module")}</span>
        <span class={`nv-badge ${statusClass(mod.data.status)}`}>{t(`status.${mod.data.status}`)}</span>
      </div>
      <h3>{mod.data.title}</h3>
      <p>{mod.data.summary}</p>
    </div>
    <span class="product-card__action">{t("modules.viewModule")}</span>
  </div>
</article>
