---
/**
 * 智驾数据闭环三张架构图：业务八环节环 · 完整架构 · 挖掘五站
 * 源图：笔记「小周谈智驾闭环」编辑版 HTML/SVG
 */
const diagrams = [
  {
    id: "business-loop",
    src: "/diagrams/ad-closed-loop/business-loop.html",
    title: "业务八环节环",
    caption:
      "采集 → 交付 → 训练 → 评测 → OTA → 回传 → 分析 → 挖掘，顺时针一圈；中心湖仓为单一事实源，挖掘为变速箱焦点。",
    aspect: "1120 / 800",
  },
  {
    id: "architecture",
    src: "/diagrams/ad-closed-loop/architecture.html",
    title: "完整架构",
    caption:
      "车端经应用层与统一门禁入湖，湖仓为单一事实源；服务层与挖掘流水线咬合，双出口回补训练集或定向采集，评测通过后 OTA 上车。",
    aspect: "1280 / 720",
  },
  {
    id: "mining-pipeline",
    src: "/diagrams/ad-closed-loop/mining-pipeline.html",
    title: "挖掘五站流水线",
    caption:
      "分层抽帧 → 统一标签 → 双引擎挖掘 → 向量化 → 多模态检索；命中回补训练集，未命中下发定向采集。未审核不进训练集。",
    aspect: "1280 / 640",
  },
] as const;
---

<section class="ad-loop-diagrams" aria-label="智驾数据闭环架构图">
  {
    diagrams.map((d) => (
      <figure class="ad-loop-diagrams__item solutions-diagram" id={`diagram-${d.id}`}>
        <p class="ad-loop-diagrams__eyebrow">Architecture</p>
        <h3 class="ad-loop-diagrams__title">{d.title}</h3>
        <div class="ad-loop-diagrams__frame" style={`aspect-ratio: ${d.aspect};`}>
          <iframe
            src={d.src}
            title={d.title}
            loading="lazy"
            referrerpolicy="no-referrer"
          />
        </div>
        <figcaption>{d.caption}</figcaption>
      </figure>
    ))
  }
</section>

<style>
  .ad-loop-diagrams {
    display: grid;
    gap: 2.5rem;
    margin: 2rem 0 0;
  }

  .ad-loop-diagrams__eyebrow {
    margin: 0 0 0.35rem;
    font-family: var(--ww-font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ww-dim);
  }

  .ad-loop-diagrams__title {
    margin: 0 0 0.85rem;
    font-family: var(--ww-font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--ww-paper);
  }

  .ad-loop-diagrams__frame {
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--ww-rule);
    background: #f5f5f5;
  }

  .ad-loop-diagrams__frame iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: #f5f5f5;
  }

  .ad-loop-diagrams__item figcaption {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--ww-dim);
  }

  @media (max-width: 720px) {
    .ad-loop-diagrams__frame {
      aspect-ratio: auto;
      height: min(70vh, 28rem);
    }
  }
</style>
