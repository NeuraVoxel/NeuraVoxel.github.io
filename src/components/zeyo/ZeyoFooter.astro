---
import WechatQr from "./WechatQr.astro";
---

<footer class="site-footer" id="about">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <a class="site-footer__logo" href="/">
        <img class="site-footer__logo-mark" src="/logo.svg" alt="" width="32" height="32" aria-hidden="true" />
        <span class="site-footer__logo-word">NeuraVoxel</span>
      </a>
      <p class="site-footer__tagline">万物闭环 · 快快乐乐生产制造</p>
      <div class="site-footer__wechat">
        <WechatQr />
        <p class="site-footer__wechat-text">
          <strong>扫码关注公众号</strong>
          获取闭环实践与工坊新作
        </p>
      </div>
    </div>

    <div class="site-footer__cols">
      <div class="site-footer__col">
        <h3 class="site-footer__col-title">产品</h3>
        <ul class="site-footer__links">
          <li><a href="/workshop/#office">Task Agent</a></li>
          <li><a href="/workshop/#driving">NeuraVoxel</a></li>
          <li><a href="/workshop/#learning">English Agent</a></li>
          <li><a href="/workshop/#career">AI摸鱼求职</a></li>
          <li><a href="/workshop/#marketing">时代之门 GEO</a></li>
