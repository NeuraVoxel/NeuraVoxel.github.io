---
import BaseLayout from "./BaseLayout.astro";
import type { Locale } from "../lib/locale";
import { href } from "../lib/locale";
import { useTranslations } from "../lib/i18n";
import type { ModuleEntry } from "../lib/content";
import Prose from "../components/Prose.astro";

interface Props {
  locale: Locale;
  currentPath: string;
  module: ModuleEntry;
}

const { locale, currentPath, module: mod } = Astro.props;
const t = useTranslations(locale);
const { Content } = await mod.render();

function externalAttrs(link: { external?: boolean }) {
  return link.external !== false
    ? { target: "_blank", rel: "noopener noreferrer" }
    : {};
}
---

<BaseLayout locale={locale} currentPath={currentPath} title={mod.data.title} description={mod.data.summary}>
  <article class="module-detail">
    <div class="module-detail__meta">
      {mod.data.role === "core" && <span class="nv-badge nv-badge--core">{t("status.core")}</span>}
      <span class="nv-badge">{t(`status.${mod.data.status}`)}</span>
    </div>
    <h1>{mod.data.title}</h1>
    <p>{mod.data.summary}</p>

    {
      mod.data.integrations && mod.data.integrations.length > 0 && (
        <section class="module-detail__section">
          <h2>{t("modules.integrations")}</h2>
          <ul>
            {mod.data.integrations.map((item) => (
              <li>{t(`modules.integrationLabels.${item}`)}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      mod.data.downloads && mod.data.downloads.length > 0 && (
        <section class="module-detail__section">
          <h2>{t("modules.downloads")}</h2>
          <ul>
            {mod.data.downloads.map((item) => (
              <li>
                <a href={item.url} {...externalAttrs({ external: true })}>{item.label}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      mod.data.links && mod.data.links.length > 0 && (
        <section class="module-detail__section">
          <h2>{t("modules.links")}</h2>
          <ul>
            {mod.data.links.map((item) => (
              <li>
                <a href={item.url} {...externalAttrs(item)}>{item.label}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      mod.data.docAnchor && (
        <p>
          <a href={href(locale, `/docs/${mod.data.docAnchor}`)}>{t("modules.viewDocs")}</a>
        </p>
      )
    }

    <Prose>
      <Content />
    </Prose>
  </article>
</BaseLayout>

<style>
  @import "../styles/pages/modules.css";
  @import "../styles/prose.css";
</style>
