---
import BaseLayout from "./BaseLayout.astro";
import DocSidebar from "../components/DocSidebar.astro";
import DocToc from "../components/DocToc.astro";
import Prose from "../components/Prose.astro";
import type { Locale } from "../lib/locale";
import type { DocEntry, DocTreeSection } from "../lib/content";
import { docSlug } from "../lib/content";
import "../styles/docs.css";

interface Props {
  locale: Locale;
  currentPath: string;
  doc: DocEntry;
  tree: DocTreeSection[];
}

const { locale, currentPath, doc, tree } = Astro.props;
const { Content, headings } = await doc.render();
const slug = docSlug(doc, locale);
---

<BaseLayout
  locale={locale}
  currentPath={currentPath}
  title={doc.data.title}
  description={doc.data.description}
  variant="docs"
>
  <div class="doc-shell">
    <div class="doc-layout">
      <DocSidebar locale={locale} tree={tree} currentSlug={slug} />
      <div class="doc-layout__main">
        <Prose>
          <h1>{doc.data.title}</h1>
          <Content />
        </Prose>
      </div>
      <DocToc locale={locale} headings={headings} />
    </div>
  </div>
</BaseLayout>
