---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CatalogEntry from "../../components/modules/CatalogEntry.astro";
import CatalogSection from "../../components/modules/CatalogSection.astro";
import { getModulesForLocale, moduleSlug } from "../../lib/content";
import { href } from "../../lib/locale";
import { useTranslations } from "../../lib/i18n";
import { getToolsForLocale } from "../../lib/tools";

const locale = "zh";
const currentPath = "/modules";
const modules = await getModulesForLocale(locale);
const tools = getToolsForLocale(locale);
const t = useTranslations(locale);

function displayHost(url: string): string {
  try {
    return new URL(url).host;
  } catch {
    return url;
  }
}
---

<BaseLayout
  locale={locale}
  currentPath={currentPath}
  title={t("modules.pageTitle")}
  description={t("modules.pageDescription")}
  variant="modules"
>
  <div class="mod-page">
    <div class="mod-page__atmosphere" aria-hidden="true"></div>
    <div class="mod-page__shell">
      <header class="mod-page__hero">
        <div class="mod-page__rail">
          <span class="nv-label">{t("modules.catalogEyebrow")}</span>
          <span class="mod-page__rail-line" aria-hidden="true"></span>
          <span class="mod-page__rail-meta">
            {tools.length} {t("modules.toolsLabel")} · {modules.length} {t("modules.modulesLabel")}
          </span>
        </div>
        <h1>{t("modules.pageTitle")}</h1>
        <p class="mod-page__lead">{t("modules.heroLead")}</p>
        <nav class="mod-page__nav" aria-label={t("modules.jumpLabel")}>
          <a href="#tools">{t("modules.jumpTools")}</a>
          <a href="#modules">{t("modules.jumpModules")}</a>
        </nav>
      </header>

      <CatalogSection
        id="tools"
        label={t("modules.toolsLabel")}
        title={t("modules.toolsTitle")}
        description={t("modules.toolsDesc")}
        count={tools.length}
      >
        {
          tools.map((tool) => (
            <CatalogEntry
              locale={locale}
              kind="tool"
              title={tool.title}
              summary={tool.summary}
              href={tool.url}
              external={true}
              status={tool.status}
              meta={displayHost(tool.url)}
              actionLabel={t("modules.openTool")}
            />
          ))
        }
      </CatalogSection>

      <CatalogSection
        id="modules"
        label={t("modules.modulesLabel")}
        title={t("modules.modulesTitle")}
        description={t("modules.modulesDesc")}
        count={modules.length}
      >
        {
          modules.map((mod) => (
            <CatalogEntry
              locale={locale}
              kind="module"
              role={mod.data.role}
              featured={mod.data.role === "core"}
              title={mod.data.title}
              summary={mod.data.summary}
              href={href(locale, `/modules/${moduleSlug(mod, locale)}`)}
              status={mod.data.status}
              actionLabel={t("modules.viewModule")}
            />
          ))
        }
      </CatalogSection>
    </div>
  </div>
</BaseLayout>

<style>
  @import "../../styles/pages/modules.css";
</style>
