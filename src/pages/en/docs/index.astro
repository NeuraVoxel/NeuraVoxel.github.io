---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import DocSidebar from "../../../components/DocSidebar.astro";
import { getDocTree } from "../../../lib/content";
import { useTranslations } from "../../../lib/i18n";
import { href, localePrefix } from "../../../lib/locale";
import "../../../styles/docs.css";

const locale = "en";
const currentPath = "/en/docs";
const prefix = localePrefix(locale);
const tree = await getDocTree(locale, prefix);
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  currentPath={currentPath}
  title={t("docs.pageTitle")}
  description={t("docs.pageDescription")}
  variant="docs"
>
  <div class="doc-shell">
    <div class="doc-layout">
      <DocSidebar locale={locale} tree={tree} />
      <div class="doc-layout__main">
        <h1>{t("docs.pageTitle")}</h1>
        <p class="doc-index-lead">
          {t("docs.pageDescription")}
          {" "}
          <a href={href(locale, "/docs/getting-started/overview")}>Start with Getting started →</a>
        </p>
      </div>
      <aside class="doc-toc doc-toc--empty" aria-hidden="true"></aside>
    </div>
  </div>
</BaseLayout>
