---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ModuleCard from "../../../components/ModuleCard.astro";
import { getModulesForLocale } from "../../../lib/content";
import { useTranslations } from "../../../lib/i18n";

const locale = "en";
const currentPath = "/en/modules";
const modules = await getModulesForLocale(locale);
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  currentPath={currentPath}
  title={t("modules.pageTitle")}
  description={t("modules.pageDescription")}
>
  <div class="page-head">
    <h1>{t("modules.pageTitle")}</h1>
    <p>{t("modules.pageDescription")}</p>
  </div>
  <div class="module-list module-list-page">
    {
      modules.length > 0 ? (
        modules.map((mod) => <ModuleCard locale={locale} module={mod} />)
      ) : (
        <p>{t("errors.missingTranslationMessage")}</p>
      )
    }
  </div>
</BaseLayout>

<style>
  @import "../../../styles/pages/modules.css";
</style>
