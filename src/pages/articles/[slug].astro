---
import { getCollection, render } from "astro:content";
import ZeyoLayout from "../../layouts/ZeyoLayout.astro";
import ScarcityLadder from "../../components/ScarcityLadder.astro";
import { getArticleBySlug } from "../../lib/content";
import { categoryLabels, lensLabels, lensFormLabels, formatArticleDate } from "../../lib/articles";
import "../../styles/zeyo/articles.css";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ id }) =>
    id.startsWith("zh/"),
  );
  return articles.map((article) => ({
    params: { slug: article.id.replace(/^zh\//, "").replace(/\.md$/, "") },
  }));
}

const locale = "zh";
const { slug } = Astro.params;
const article = await getArticleBySlug(locale, slug!);

if (!article) {
  return Astro.redirect("/404");
}

const { Content } = await render(article);
---

<ZeyoLayout
  currentPath="/articles/"
  title={`${article.data.title} — NeuraVoxel`}
  description={article.data.description}
>
  <article class="article-detail">
    <header class="article-detail__head">
      <div class="article-detail__meta">
        <span class="cat-badge">{categoryLabels[article.data.category]}</span>
        {article.data.lens && (
          <span class="cat-badge cat-badge--lens">
            {lensLabels[article.data.lens]}
            {article.data.lensForm && ` · ${lensFormLabels[article.data.lensForm]}`}
          </span>
        )}
        <time datetime={formatArticleDate(article.data.date)}>
          {formatArticleDate(article.data.date)}
        </time>
      </div>
      <h1 class="article-detail__title">{article.data.title}</h1>
      <p class="article-detail__desc">{article.data.description}</p>
    </header>
    <div class="article-detail__body">
      <Content />
    </div>

    {
      article.data.diagram === "scarcity" && (
        <aside class="article-detail__figure" aria-labelledby="article-figure-title">
          <p class="ww-label">延伸图示</p>
          <h2 class="article-detail__figure-title" id="article-figure-title">稀缺性阶梯</h2>
          <ScarcityLadder />
        </aside>
      )
    }

    <footer class="article-detail__foot">
      <a class="btn btn--ghost" href="/articles/">← 返回文章列表</a>
    </footer>
  </article>
</ZeyoLayout>

<style>
  .article-detail {
    max-width: 56rem;
    margin: 0 auto;
    padding: 3rem var(--ww-page-x) 4rem;
  }

  .article-detail__head {
    margin-bottom: 2.5rem;
  }

  .article-detail__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    font-family: var(--ww-font-mono);
    font-size: 0.8125rem;
    color: var(--ww-dim);
  }

  /* 哲学层面徽标：与 series 徽标同色系，区别于分类徽标 */
  .article-detail__meta :global(.cat-badge--lens) {
    color: var(--ww-signal-dim);
  }

  .article-detail__title {
    font-family: var(--ww-font-display);
    font-size: clamp(1.875rem, 4vw, 2.75rem);
    font-weight: 600;
    line-height: 1.3;
    color: var(--ww-paper);
    margin: 0 0 1.125rem;
  }

  .article-detail__desc {
    font-size: 1.1875rem;
    line-height: 1.7;
    color: var(--ww-mist);
    margin: 0;
  }

  .article-detail__body :global(h2) {
    font-family: var(--ww-font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--ww-paper);
    margin: 2.5rem 0 1rem;
  }

  .article-detail__body :global(h3) {
    font-family: var(--ww-font-display);
    font-size: 1.1875rem;
    font-weight: 600;
    color: var(--ww-paper);
    margin: 1.75rem 0 0.75rem;
  }

  .article-detail__body :global(p) {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--ww-mist);
    margin: 0 0 1.125rem;
  }

  .article-detail__body :global(li) {
    margin-bottom: 0.375rem;
  }

  .article-detail__body :global(ul) {
    margin: 0 0 1.125rem;
    padding-left: 1.25rem;
    color: var(--ww-mist);
    font-size: 1.125rem;
    line-height: 1.8;
  }

  .article-detail__body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 0.9375rem;
  }

  .article-detail__body :global(th),
  .article-detail__body :global(td) {
    border: 1px solid var(--ww-rule);
    padding: 0.5rem 0.75rem;
    text-align: left;
    color: var(--ww-mist);
  }

  .article-detail__body :global(th) {
    color: var(--ww-paper);
    background: var(--ww-elevated);
  }

  .article-detail__body :global(strong) {
    color: var(--ww-paper);
  }

  /* 金句：左信号色竖线 + 抬升字号，用于突出核心论断 */
  .article-detail__body :global(blockquote) {
    margin: 1.75rem 0;
    padding: 1.125rem 1.25rem;
    border-left: 3px solid var(--ww-signal);
    background: var(--ww-surface);
    border-radius: 0 8px 8px 0;
  }

  .article-detail__body :global(blockquote p) {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.7;
    color: var(--ww-paper);
  }

  /* 信息图：与正文栏严格同宽，保持左右边界对齐 */
  .article-detail__body :global(p:has(> img)) {
    margin-bottom: 0.75rem;
  }

  .article-detail__body :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--ww-rule);
  }

  .article-detail__body :global(p:has(> img) + p) {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--ww-dim);
    text-align: center;
    margin-bottom: 2rem;
  }

  .article-detail__figure {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--ww-rule);
  }

  .article-detail__figure .ww-label {
    margin: 0 0 0.5rem;
  }

  .article-detail__figure-title {
    font-family: var(--ww-font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--ww-paper);
    margin: 0 0 1.25rem;
  }

  .article-detail__foot {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--ww-rule);
  }
</style>
