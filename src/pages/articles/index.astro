---
import ZeyoLayout from "../../layouts/ZeyoLayout.astro";
import CooperationStrip from "../../components/zeyo/CooperationStrip.astro";
import { getArticlesForLocale, articleSlug } from "../../lib/content";
import {
  categoryLabels,
  seriesLabels,
  lensLabels,
  lensDescriptions,
  lensOrder,
  formatArticleDate,
} from "../../lib/articles";
import "../../styles/zeyo/articles.css";

const locale = "zh";
const articles = await getArticlesForLocale(locale);
const featured = articles.find((a) => a.data.featured) ?? articles[0];
const listArticles = articles.filter((a) => a !== featured);
---

<ZeyoLayout
  currentPath="/articles/"
  title="文章 — NeuraVoxel"
  description="NeuraVoxel · 闭环思维 — 从闭环视角看世界。方法论、场景实践、Agent × 闭环"
>
  <header class="page-head">
    <p class="ww-label">Closed-Loop Thinking</p>
    <h1 class="page-head__title">闭环思维</h1>
    <p class="page-head__desc">
      NeuraVoxel 思想阵地 — 从闭环视角看世界：方法论、场景实践、Agent 与闭环。
    </p>
  </header>

  <div class="articles-layout">
    <div class="filter-tabs" role="tablist" aria-label="文章分类">
      <button class="filter-tab" role="tab" aria-selected="false" data-filter="all">全部</button>
      <button class="filter-tab" role="tab" aria-selected="true" data-filter="ai-select">《AI选》</button>
      <button class="filter-tab" role="tab" aria-selected="false" data-filter="ai-augmentation">《AI增强》</button>
      <button class="filter-tab" role="tab" aria-selected="false" data-filter="thinking">闭环思维</button>
      <button class="filter-tab" role="tab" aria-selected="false" data-filter="practice">场景实践</button>
      <button class="filter-tab" role="tab" aria-selected="false" data-filter="agent">Agent × 闭环</button>
    </div>

    <div class="view-toggle" role="group" aria-label="文章视图">
      <button class="view-toggle__btn" type="button" data-view="time" aria-pressed="false">
        按时间
      </button>
      <button class="view-toggle__btn" type="button" data-view="lens" aria-pressed="true">
        按哲学层面
      </button>
    </div>

    {
      featured && (
        <a
          class="article-featured"
          href={`/articles/${articleSlug(featured, locale)}/`}
          data-category={featured.data.category}
          data-series={featured.data.series}
        >
          <div class="article-featured__visual" aria-hidden="true">
            <div class="article-featured__ring"></div>
          </div>
          <div class="article-featured__content">
            <div class="article-featured__meta">
              <span class="cat-badge">{categoryLabels[featured.data.category]}</span>
              {featured.data.series && (
                <span class="cat-badge cat-badge--series">{seriesLabels[featured.data.series]}</span>
              )}
            </div>
            <h2 class="article-featured__title">{featured.data.title}</h2>
            <p class="article-featured__excerpt">{featured.data.description}</p>
            <time class="article-featured__date" datetime={formatArticleDate(featured.data.date)}>
              {formatArticleDate(featured.data.date)}
            </time>
            <p class="article-featured__cta">阅读全文 →</p>
          </div>
        </a>
      )
    }

    <div class="article-list">
      {
        listArticles.map((article) => (
          <a
            class="article-row"
            href={`/articles/${articleSlug(article, locale)}/`}
            data-category={article.data.category}
            data-series={article.data.series}
            data-lens={article.data.lens ?? "none"}
          >
            <time class="article-row__date" datetime={formatArticleDate(article.data.date)}>
              {formatArticleDate(article.data.date)}
            </time>
            <div class="article-row__body">
              <div class="article-row__cat">
                <span class="cat-badge">{categoryLabels[article.data.category]}</span>
                {article.data.series && (
                  <span class="cat-badge cat-badge--series">{seriesLabels[article.data.series]}</span>
                )}
              </div>
              <h3 class="article-row__title">{article.data.title}</h3>
              <p class="article-row__excerpt">{article.data.description}</p>
            </div>
            <span class="article-row__arrow" aria-hidden="true">→</span>
          </a>
        ))
      }
    </div>

    <div class="article-groups" hidden>
      {
        [...lensOrder, "none" as const].map((lens) => (
          <section class="article-group" data-lens={lens} hidden>
            <header class="article-group__head">
              <h2 class="article-group__title">
                {lens === "none" ? "其他" : lensLabels[lens]}
                <span class="article-group__count" aria-hidden="true"></span>
              </h2>
              <p class="article-group__desc">
                {lens === "none"
                  ? "尚未归入哲学层面的文章"
                  : lensDescriptions[lens]}
              </p>
            </header>
            <div class="article-group__list"></div>
          </section>
        ))
      }
    </div>
  </div>

  <CooperationStrip
    id="articles-cooperation"
    desc="产品共建、场景对接、技术合作 — 欢迎探讨闭环共建"
  />
</ZeyoLayout>

<script is:inline>
  (function () {
    const tabs = document.querySelectorAll(".filter-tab");
    const viewBtns = document.querySelectorAll(".view-toggle__btn");
    const featured = document.querySelector(".article-featured");
    const list = document.querySelector(".article-list");
    const groups = document.querySelector(".article-groups");
    const rows = Array.from(document.querySelectorAll(".article-row"));

    /* 只有《AI选》做了哲学层面标注，分组视图强制限定在该专栏内 */
    var LENS_SERIES = "ai-select";

    let filter = "all";
    let view = "time";
    /* 用户手动选过视图后，切专栏时不再回落到默认 */
    let viewPicked = false;

    function match(el) {
      return (
        filter === "all" ||
        el.dataset.category === filter ||
        el.dataset.series === filter
      );
    }

    /* 分组视图只是把同一批行节点重新挂载到对应层面下，不重复渲染 */
    function place() {
      if (view === "time" || !groups) {
        rows.forEach((row) => list && list.appendChild(row));
        return;
      }
      rows.forEach((row) => {
        const lens = row.dataset.lens || "none";
        const slot = groups.querySelector(
          '.article-group[data-lens="' + CSS.escape(lens) + '"] .article-group__list',
        );
        (slot || list).appendChild(row);
      });
    }

    function render() {
      rows.forEach((row) => {
        row.hidden = !match(row);
      });
      if (featured) featured.hidden = !match(featured);

      place();

      if (list) list.hidden = view !== "time";
      if (groups) groups.hidden = view !== "lens";

      if (groups) {
        groups.querySelectorAll(".article-group").forEach((group) => {
          const visible = Array.from(
            group.querySelectorAll(".article-row"),
          ).filter((row) => !row.hidden);
          group.hidden = visible.length === 0;
          const count = group.querySelector(".article-group__count");
          if (count) count.textContent = String(visible.length);
        });
      }
    }

    function setFilter(next) {
      filter = next;
      tabs.forEach((t) =>
        t.setAttribute("aria-selected", t.dataset.filter === next ? "true" : "false"),
      );
      render();
    }

    function setView(next) {
      view = next;
      viewBtns.forEach((b) =>
        b.setAttribute("aria-pressed", b.dataset.view === next ? "true" : "false"),
      );
      render();
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const next = tab.dataset.filter;
        /* 《AI选》默认按哲学层面展示，其余专栏没有层面标注，按时间 */
        if (next === LENS_SERIES) {
          if (!viewPicked) setView("lens");
        } else {
          setView("time");
        }
        setFilter(next);
      });
    });

    viewBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        viewPicked = true;
        if (btn.dataset.view === "lens") {
          view = "lens";
          viewBtns.forEach((b) =>
            b.setAttribute("aria-pressed", b.dataset.view === "lens" ? "true" : "false"),
          );
          setFilter(LENS_SERIES);
          return;
        }
        setView("time");
      });
    });

    const params = new URLSearchParams(location.search);
    const requested = params.get("series");
    const requestedTab = requested
      ? document.querySelector('.filter-tab[data-filter="' + CSS.escape(requested) + '"]')
      : null;
    const initialTab =
      requestedTab ?? document.querySelector('.filter-tab[aria-selected="true"]');
    if (initialTab) {
      filter = initialTab.dataset.filter;
      tabs.forEach((t) =>
        t.setAttribute("aria-selected", t === initialTab ? "true" : "false"),
      );
    }

    const viewParam = params.get("view");
    /* 《AI选》默认按哲学层面展示；其余专栏回落到时间视图 */
    const useLens =
      viewParam === "lens" ||
      (viewParam !== "time" && filter === LENS_SERIES);

    view = useLens ? "lens" : "time";
    viewBtns.forEach((b) =>
      b.setAttribute("aria-pressed", b.dataset.view === view ? "true" : "false"),
    );

    render();
  })();
</script>
