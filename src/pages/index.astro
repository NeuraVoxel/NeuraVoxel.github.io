---
import ZeyoLayout from "../layouts/ZeyoLayout.astro";
import CooperationStrip from "../components/zeyo/CooperationStrip.astro";
import { getArticlesForLocale, articleSlug } from "../lib/content";
import { seriesLabels, formatArticleDate } from "../lib/articles";
import "../styles/zeyo/home.css";

const locale = "zh";
const articles = await getArticlesForLocale(locale);
const latestArticles = articles.slice(0, 3);
---

<ZeyoLayout
  currentPath="/"
  title="NeuraVoxel · 万物闭环 — 驾驭概率，交付确定"
  description="以闭环思维为核心，用「概率性大模型 × 确定性规则系统」双引擎，把 AI 的不确定性收敛为可验证、可复现的确定性交付。AI 出候选，人做确认。"
>
  <section class="hero" id="top" aria-labelledby="hero-title">
    <div class="hero__bg" aria-hidden="true">
      <div class="hero__grid"></div>
      <div class="hero__glow"></div>
    </div>

    <div class="hero__layout">
      <div class="hero__copy">
        <p class="ww-label">NeuraVoxel · 万物闭环 × 双引擎</p>
        <h1 class="hero__title" id="hero-title">万物闭环</h1>
        <p class="hero__subtitle">驾驭概率，交付确定</p>
        <p class="hero__support">
          AI 出候选，人做确认。以「概率性大模型 ×
          确定性规则系统」双引擎，把不确定性收敛为可验证、可复现的确定性交付。
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/contact/">合作咨询</a>
          <a class="btn btn--ghost" href="/workshop/">探索工坊 →</a>
        </div>
      </div>

      <figure
        class="living-loop"
        aria-label="双飞轮闭环体系：顶层确定性业务闭环（业务飞轮）由部门输出→协同校验→责任签字→对外交付→反馈归因构成；中层五个小模块闭环（客服/财务/研发/合同/运营）共同驱动业务飞轮与智能飞轮；底层智能闭环（智能飞轮）由校验→过滤→兜底→追溯构成；业务飞轮与智能飞轮经左右两侧交互循环迭代相互啮合，小模块闭环向上汇入业务、向下汇入智能并回流"
      >
        <svg viewBox="0 0 400 440" fill="none" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <marker
              id="hero-arrow"
              viewBox="0 0 10 10"
              refX="8"
              refY="5"
              markerWidth="6"
              markerHeight="6"
              orient="auto"
            >
              <path d="M0 0 L10 5 L0 10 Z" class="hero-arrow-fill"></path>
            </marker>
          </defs>

          <!-- 顶层：确定性业务闭环 / 业务飞轮 -->
          <ellipse class="loop-disc loop-disc--biz" cx="200" cy="96" rx="150" ry="52"></ellipse>
          <ellipse class="loop-ring loop-ring--biz" cx="200" cy="96" rx="150" ry="52"></ellipse>
          <ellipse class="loop-ring loop-ring--biz loop-ring--active" cx="200" cy="96" rx="150" ry="52"></ellipse>

          <text class="loop-center__text loop-center__text--main" x="200" y="92">确定性业务闭环</text>
          <text class="loop-center__text loop-center__text--sub loop-center__text--biz" x="200" y="110">业务飞轮</text>

          <g class="loop-node loop-node--biz" data-stage="perceive" data-index="0" transform="translate(200, 44)">
            <rect class="loop-pill" x="-30" y="-9" width="60" height="18" rx="9"></rect>
            <text class="loop-pill__label" y="3.5">部门输出</text>
          </g>
          <g class="loop-node loop-node--biz" data-stage="process" data-index="1" transform="translate(341, 78)">
            <rect class="loop-pill" x="-30" y="-9" width="60" height="18" rx="9"></rect>
            <text class="loop-pill__label" y="3.5">协同校验</text>
          </g>
          <g class="loop-node loop-node--biz" data-stage="train" data-index="2" transform="translate(315, 131)">
            <rect class="loop-pill" x="-30" y="-9" width="60" height="18" rx="9"></rect>
            <text class="loop-pill__label" y="3.5">责任签字</text>
          </g>
          <g class="loop-node loop-node--biz" data-stage="simulate" data-index="3" transform="translate(85, 131)">
            <rect class="loop-pill" x="-30" y="-9" width="60" height="18" rx="9"></rect>
            <text class="loop-pill__label" y="3.5">对外交付</text>
          </g>
          <g class="loop-node loop-node--biz" data-stage="return" data-index="4" transform="translate(59, 78)">
            <rect class="loop-pill" x="-30" y="-9" width="60" height="18" rx="9"></rect>
            <text class="loop-pill__label" y="3.5">反馈归因</text>
          </g>

          <text class="hero-note hero-note--biz" x="356" y="99">责任锚定</text>

          <!-- 中层：小模块闭环 · 共同驱动双飞轮 -->
          {
            [
              { x: 60, label: "客服" },
              { x: 130, label: "财务" },
              { x: 200, label: "研发" },
              { x: 270, label: "合同" },
              { x: 340, label: "运营" },
            ].map(({ x, label }, i) => (
              <>
                {i > 0 && (
                  <path
                    class="hero-link"
                    d={`M${x - 46} 250 H${x - 28}`}
                    marker-end="url(#hero-arrow)"
                  ></path>
                )}
                <g class="dept-ring" transform={`translate(${x}, 250)`}>
                  <circle r="24"></circle>
                  <circle class="dept-ring__spin" r="19" style={`--i: ${i}`}></circle>
                  <text y="4">{label}</text>
                </g>
              </>
            ))
          }
          <text class="hero-note hero-note--center" x="200" y="296">小模块闭环 · 共同驱动 业务飞轮 × 智能飞轮</text>

          <!-- 小模块闭环 ↔ 确定性业务闭环（向上汇入）-->
          <path class="hero-link hero-link--up" d="M130 226 V150" marker-end="url(#hero-arrow)"></path>
          <path class="hero-link hero-link--up" d="M200 226 V150" marker-end="url(#hero-arrow)"></path>
          <path class="hero-link hero-link--up" d="M270 226 V150" marker-end="url(#hero-arrow)"></path>
          <!-- 小模块闭环 ↔ 智能闭环（向下汇入）-->
          <path class="hero-link hero-link--down" d="M130 274 V306" marker-end="url(#hero-arrow)"></path>
          <path class="hero-link hero-link--down" d="M200 274 V306" marker-end="url(#hero-arrow)"></path>
          <path class="hero-link hero-link--down" d="M270 274 V306" marker-end="url(#hero-arrow)"></path>

          <!-- 底层：智能闭环 / 智能飞轮（小一号）-->
          <ellipse class="loop-disc loop-disc--intel" cx="200" cy="350" rx="120" ry="42"></ellipse>
          <ellipse class="loop-ring loop-ring--intel" cx="200" cy="350" rx="120" ry="42"></ellipse>
          <ellipse class="loop-ring loop-ring--intel loop-ring--active" cx="200" cy="350" rx="120" ry="42"></ellipse>

          <text class="loop-center__text loop-center__text--main" x="200" y="346">智能闭环</text>
          <text class="loop-center__text loop-center__text--sub loop-center__text--intel" x="200" y="364">智能飞轮</text>

          <g class="loop-node loop-node--intel" data-stage="perceive" data-index="5" transform="translate(200, 308)">
            <rect class="loop-pill" x="-30" y="-9" width="60" height="18" rx="9"></rect>
            <text class="loop-pill__label" y="3.5">校验</text>
          </g>
          <g class="loop-node loop-node--intel" data-stage="process" data-index="6" transform="translate(312, 344)">
            <rect class="loop-pill" x="-30" y="-9" width="60" height="18" rx="9"></rect>
            <text class="loop-pill__label" y="3.5">过滤</text>
          </g>
          <g class="loop-node loop-node--intel" data-stage="train" data-index="7" transform="translate(200, 392)">
            <rect class="loop-pill" x="-30" y="-9" width="60" height="18" rx="9"></rect>
            <text class="loop-pill__label" y="3.5">兜底</text>
          </g>
          <g class="loop-node loop-node--intel" data-stage="return" data-index="8" transform="translate(88, 344)">
            <rect class="loop-pill" x="-30" y="-9" width="60" height="18" rx="9"></rect>
            <text class="loop-pill__label" y="3.5">追溯</text>
          </g>

          <text class="hero-note hero-note--intel" x="356" y="353">AI 生成 → 兜底</text>

          <!-- 双飞轮交互循环迭代：金→青（智能驱动业务）/ 青→金（业务反哺智能）-->
          <path
            class="hero-link hero-link--intel"
            d="M80 340 C 44 280, 44 180, 55 108"
            marker-end="url(#hero-arrow)"
          ></path>
          <text class="hero-note hero-note--left" transform="rotate(-90 14 224)" x="14" y="224">
            交互循环迭代
          </text>

          <path
            class="hero-link hero-link--biz"
            d="M345 108 C 376 180, 376 280, 320 340"
            marker-end="url(#hero-arrow)"
          ></path>
          <text class="hero-note" transform="rotate(-90 386 224)" x="386" y="224">经验沉淀回流</text>

          <!-- 图例 -->
          <g class="loop-legend">
            <circle class="loop-legend__dot" cx="150" cy="425" r="4"></circle>
            <text class="loop-legend__text" x="160" y="428">业务飞轮</text>
            <circle class="loop-legend__dot loop-legend__dot--intel" cx="214" cy="425" r="4"></circle>
            <text class="loop-legend__text" x="224" y="428">智能飞轮</text>
          </g>

          <circle
            class="loop-pulse"
            r="5"
            style="offset-path: path('M 50 96 A 150 52 0 0 1 350 96 A 150 52 0 0 1 50 96')"
          ></circle>
          <circle
            class="loop-pulse loop-pulse--rules"
            r="4"
            style="offset-path: path('M 80 350 A 120 42 0 0 1 320 350 A 120 42 0 0 1 80 350')"
          ></circle>
        </svg>
      </figure>
    </div>
  </section>

  <section class="ww-section" id="thinking" aria-labelledby="thinking-title">
    <div class="ww-section__inner">
      <header class="ww-section__head">
        <p class="ww-label">How We Think</p>
        <h2 class="ww-section__title" id="thinking-title">闭环思维是什么</h2>
        <p class="ww-section__desc">
          不是做单点工具，而是识别环上的断点，逐个连接、逐个闭环；驾驭概率性工具，交付确定性结果。
        </p>
      </header>
      <div class="thinking-grid">
        <article class="thinking-card">
          <p class="thinking-card__arc">输入 → 反馈</p>
          <h3 class="thinking-card__title">看问题</h3>
          <p class="thinking-card__body">
            任何事物都是一个环：输入 → 处理 → 输出 → 反馈 →
            再输入。找到断点，比造更大的环更重要。
          </p>
        </article>
        <article class="thinking-card">
          <p class="thinking-card__arc">断点 → 连接</p>
          <h3 class="thinking-card__title">做产品</h3>
          <p class="thinking-card__body">
            不是做单点工具，而是识别环上断点，逐个连接、逐个闭环。每一个小工具，攻克环上的一个环节。
          </p>
        </article>
        <article class="thinking-card">
          <p class="thinking-card__arc">Agent → 环节</p>
          <h3 class="thinking-card__title">AI 时代</h3>
          <p class="thinking-card__body">
            Agent 让环上每个环节都可以智能化——采集 Agent、标注
            Agent、复盘 Agent……智能体一点点填满环上的空白。
          </p>
        </article>
        <article class="thinking-card">
          <p class="thinking-card__arc">概率 → 确定</p>
          <h3 class="thinking-card__title">确定交付</h3>
          <p class="thinking-card__body">
            驾驭概率性工具的同时，坚守确定性交付的底线。AI
            可以生成，交付必须确定——校验、审核、回流，把不确定性收敛为可交付的结果。
          </p>
        </article>
        <article class="thinking-card">
          <p class="thinking-card__arc">杠杆 → 增强</p>
          <h3 class="thinking-card__title">AI 增强</h3>
          <p class="thinking-card__body">
            AI 是杠杆，撬动的是人的主动性：效率增强、能力增强、认知增强三层递进。替代是假命题，增强才是真方向。
          </p>
        </article>
      </div>

      <a class="engine-cta" href="/solutions/">
        <span class="engine-cta__formula">概率 × 规则 = 确定性</span>
        <span class="engine-cta__desc">双引擎如何把 AI 的不确定性收敛为可交付的结果</span>
        <span class="engine-cta__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <hr class="ww-rule" />

  <section class="ww-section" id="closed-loop-system" aria-labelledby="closed-loop-title">
    <div class="ww-section__inner">
      <header class="ww-section__head">
        <p class="ww-label">From Probability to Accountability</p>
        <h2 class="ww-section__title" id="closed-loop-title">从概率到责任：AI 确定性闭环重构体系</h2>
        <p class="ww-section__desc">
          模型吐出的是概率，业务要的是交付。从人类信号出发，经数据层汇聚、闭环层收敛、责任信任层治理，最终交付可信、可靠、可解释的结果。
          <strong>不消除不确定性，而是用系统兜住它。</strong>
        </p>
      </header>
      <figure class="loop-figure">
        <img
          src="/AI%20确定性闭环重构体系.jpeg"
          alt="AI 确定性闭环重构体系：从人类信号出发，经数据层（汇聚与预处理）、闭环层（LLM 概率环 × HUMAN 反馈环的 DevOps 双环）、责任信任层（规则制度与伦理合规），最终交付给人类——可信、可靠、可解释"
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          信号 → 数据 → 闭环 → 治理 → 交付：每过一层，概率就被收紧一分。
        </figcaption>
      </figure>
    </div>
  </section>

  <hr class="ww-rule" />

  <section class="ww-section" aria-labelledby="scenes-title">
    <div class="ww-section__inner">
      <header class="ww-section__head">
        <p class="ww-label">What We Build</p>
        <h2 class="ww-section__title" id="scenes-title">我们在攻克的场景</h2>
        <p class="ww-section__desc">
          每个场景都是一个独立的环。从小做起，做好每一个小工具。
        </p>
      </header>
      <div class="scene-grid">
        <a class="scene-card" href="/workshop/#office">
          <div class="scene-card__loop" aria-hidden="true">
            <span>规划</span><span class="arrow">→</span>
            <span>执行</span><span class="arrow">→</span>
            <span>复盘</span><span class="arrow">→</span>
            <span>优化</span>
          </div>
          <h3 class="scene-card__title">AI办公</h3>
            <p class="scene-card__desc">
              规划→执行→复盘→优化的办公闭环。Task Agent 与 Task Skill 推进任务协作，Token 计价器与 DSH Turn Cost 让 AI 成本可控。
            </p>
            <p class="scene-card__gap">断点：任务做完即散，复盘没有回流到下一次规划</p>
            <span class="scene-card__meta">6 项作品 →</span>
        </a>

        <a class="scene-card" href="/workshop/#driving">
          <div class="scene-card__loop" aria-hidden="true">
            <span>采集</span><span class="arrow">→</span>
            <span>标注</span><span class="arrow">→</span>
            <span>训练</span><span class="arrow">→</span>
            <span>仿真</span><span class="arrow">→</span>
            <span>回流</span>
          </div>
          <h3 class="scene-card__title">自动驾驶</h3>
            <p class="scene-card__desc">
              NeuraVoxel 系列：数据从采集到训练到仿真到回流，全链路闭环。多源对齐，版本可追溯。
            </p>
            <p class="scene-card__gap">断点：仿真发现的长尾缺少回流通道，难以回到训练</p>
            <span class="scene-card__meta">4 项作品 →</span>
        </a>

        <a class="scene-card scene-card--muted" href="/workshop/#embodied">
          <div class="scene-card__loop" aria-hidden="true">
            <span>感知</span><span class="arrow">→</span>
            <span>决策</span><span class="arrow">→</span>
            <span>执行</span><span class="arrow">→</span>
            <span>回流</span>
          </div>
          <h3 class="scene-card__title">具身智能</h3>
            <p class="scene-card__desc">
              感知→决策→执行→回流的具身闭环。演示与真机数据对齐，缩短迭代。
            </p>
            <p class="scene-card__gap">断点：演示数据与真机数据不对齐，回流失真</p>
            <span class="scene-card__meta">即将开放 →</span>
        </a>

        <a class="scene-card" href="/workshop/#digital-twin">
          <div class="scene-card__loop" aria-hidden="true">
            <span>采集</span><span class="arrow">→</span>
            <span>重建</span><span class="arrow">→</span>
            <span>精修</span><span class="arrow">→</span>
            <span>交付</span>
          </div>
          <h3 class="scene-card__title">数字孪生</h3>
            <p class="scene-card__desc">
              采集→重建→精修→交付的孪生闭环。3DGS Agent 一条流水线，四个站点串成环。
            </p>
            <p class="scene-card__gap">断点：重建到精修靠人工，交付口径不统一</p>
            <span class="scene-card__meta">1 项作品 →</span>
        </a>

        <a class="scene-card" href="/workshop/#learning">
          <div class="scene-card__loop" aria-hidden="true">
            <span>输入</span><span class="arrow">→</span>
            <span>练习</span><span class="arrow">→</span>
            <span>反馈</span><span class="arrow">→</span>
            <span>迭代</span>
          </div>
          <h3 class="scene-card__title">教育学习</h3>
            <p class="scene-card__desc">
              输入→练习→反馈→再输入的学习闭环。English Agent 让每次对话都成为环上的一环。
            </p>
            <p class="scene-card__gap">断点：练习得不到即时反馈，反馈不转化为下一次输入</p>
            <span class="scene-card__meta">1 项作品 →</span>
        </a>

        <a class="scene-card" href="/workshop/#career">
          <div class="scene-card__loop" aria-hidden="true">
            <span>发现</span><span class="arrow">→</span>
            <span>准备</span><span class="arrow">→</span>
            <span>投递</span><span class="arrow">→</span>
            <span>复盘</span>
          </div>
          <h3 class="scene-card__title">职场求职</h3>
            <p class="scene-card__desc">
              发现→准备→投递→复盘的求职闭环。AI摸鱼求职匹配岗位，Resume Agent 从上传到导出打磨简历。
            </p>
            <p class="scene-card__gap">断点：投递之后没有沉淀，复盘缺数据</p>
            <span class="scene-card__meta">2 项作品 →</span>
        </a>

        <a class="scene-card" href="/workshop/#marketing">
          <div class="scene-card__loop" aria-hidden="true">
            <span>洞察</span><span class="arrow">→</span>
            <span>创作</span><span class="arrow">→</span>
            <span>分发</span><span class="arrow">→</span>
            <span>优化</span>
          </div>
          <h3 class="scene-card__title">市场营销</h3>
            <p class="scene-card__desc">
              洞察→创作→分发→优化的营销闭环。时代之门 GEO 与 GeoFlow，让品牌知识成为 AI 答案中的可信引用。
            </p>
            <p class="scene-card__gap">断点：AI 答案中的引用不可见、不可测，优化断在分发之后</p>
            <span class="scene-card__meta">2 项作品 →</span>
        </a>

        <a class="scene-card scene-card--muted" href="/workshop/#more">
          <div class="scene-card__loop" aria-hidden="true">
            <span>制造</span><span class="arrow">→</span>
            <span>医疗</span><span class="arrow">→</span>
            <span>……</span>
          </div>
          <h3 class="scene-card__title">更多场景</h3>
            <p class="scene-card__desc">
              每个新场景都是一个新的环。制造、医疗等领域正在规划中，敬请期待。
            </p>
            <p class="scene-card__gap">断点：环尚未识别，等待第一个断点被找到</p>
            <span class="scene-card__meta">即将开放 →</span>
        </a>
      </div>
    </div>
  </section>

  <hr class="ww-rule" />

  <section class="ww-section" id="thoughts" aria-labelledby="thoughts-title">
    <div class="ww-section__inner">
      <header class="ww-section__head">
        <p class="ww-label">Writing</p>
        <h2 class="ww-section__title" id="thoughts-title">思想阵地</h2>
        <p class="ww-section__desc">
          讲台上的闭环：方法论、矛盾分析与行动纲领，都在《AI选》与《AI增强》两个栏目里。
        </p>
      </header>

      <div class="thought-grid">
        {
          latestArticles.map((article) => (
            <a class="thought-card" href={`/articles/${articleSlug(article, locale)}/`}>
              <div class="thought-card__meta">
                {article.data.series && (
                  <span class="cat-badge cat-badge--series">{seriesLabels[article.data.series]}</span>
                )}
                <time datetime={formatArticleDate(article.data.date)}>
                  {formatArticleDate(article.data.date)}
                </time>
              </div>
              <h3 class="thought-card__title">{article.data.title}</h3>
              <p class="thought-card__excerpt">{article.data.description}</p>
              <span class="thought-card__cta">阅读全文 →</span>
            </a>
          ))
        }
      </div>

      <div class="thought-cols">
        <a class="thought-col" href="/articles/?series=ai-select">
          <span class="thought-col__badge">《AI选》</span>
          <span class="thought-col__desc">AI 时代的方法论与矛盾分析</span>
