---
import ZeyoLayout from "../../layouts/ZeyoLayout.astro";
import CooperationStrip from "../../components/zeyo/CooperationStrip.astro";
import HarnessDiagram from "../../components/zeyo/HarnessDiagram.astro";
import TaskRoutingDiagram from "../../components/TaskRoutingDiagram.astro";
import { getAllSolutionLandings, getSolutionTree } from "../../lib/content";
import { solutionKindLabels } from "../../data/solutions.types";
import "../../styles/zeyo/solutions.css";

const locale = "zh";
const systems = await getSolutionTree(locale);
const landings = await getAllSolutionLandings(locale);

const systemTitles = new Map(
  systems.map((system) => [system.slug, system.entry.data.title]),
);

function systemsOf(entry: (typeof landings)[number]["entry"]): string[] {
  const list = entry.data.systems ?? (entry.data.parent ? [entry.data.parent] : []);
  return list.map((slug) => systemTitles.get(slug) ?? slug);
}

const statusLabels: Record<string, string> = {
  available: "已开放",
  preview: "预览",
  planned: "规划中",
};
---

<ZeyoLayout
  currentPath="/solutions/"
  title="方案 — NeuraVoxel"
  description="NeuraVoxel 落地方案：以工程化收敛体系为底座，把概率性的大模型输出收敛为确定性的商业交付。"
  pageClass="solutions-page"
>
  <header class="page-head">
    <p class="ww-label">Solutions</p>
    <h1 class="page-head__title">方案</h1>
    <p class="page-head__desc">
      一套方法，落到各行各业——但落到每个行业，都必须<strong>具体问题具体分析</strong>。矛盾的普遍性使方法可以复用，矛盾的特殊性决定落地不能照搬。
    </p>
  </header>

  <div class="solutions-flow">
    <section class="ww-section" aria-labelledby="solutions-stance">
      <div class="ww-section__inner">
        <header class="ww-section__head">
          <p class="ww-label">Why · 立场</p>
          <h2 class="ww-section__title" id="solutions-stance">共性可复用，个性须具体分析</h2>
          <p class="ww-section__desc">
            所有行业面对同一个根本矛盾：概率性的模型与确定性的交付。矛盾是共同的，解法却必须具体。
          </p>
        </header>

        <div class="stance-grid">
          <article class="stance-card">
            <p class="stance-card__label">共性 · 普遍性</p>
            <h3 class="stance-card__title">方法可以复用</h3>
            <p class="stance-card__body">
              四道防线与闭环结构是通用的——数据治理、工作流编排、AI 护栏、人机审核，不因行业而改变。
            </p>
          </article>
          <article class="stance-card">
            <p class="stance-card__label">个性 · 特殊性</p>
            <h3 class="stance-card__title">落地必须具体分析</h3>
            <p class="stance-card__body">
              自动驾驶的矛盾在长尾场景与责任归属，金融在合规与可审计，医疗在证据与容错边界。照搬体系，就是本本主义。
            </p>
          </article>
          <article class="stance-card">
            <p class="stance-card__label">共性 → 个性</p>
            <h3 class="stance-card__title">在具体分析中复用</h3>
            <p class="stance-card__body">
              体系给的是问题清单与工程组件，不是现成答案。先分析行业的具体矛盾，再定防线配置、阈值与责任划分。
            </p>
          </article>
        </div>

        <div class="formula-band">
          <p class="ww-label formula-band__label">How · 概率 × 规则 = 确定性</p>
          <div class="formula-band__row">
            <div class="formula-band__cell formula-band__cell--prob">
              <p class="formula-band__key">概率性大模型</p>
              <p class="formula-band__trait">归纳 ・ 生成 ・ 不确定性</p>
            </div>
            <span class="formula-band__op" aria-hidden="true">×</span>
            <div class="formula-band__cell">
              <p class="formula-band__key">确定性规则系统</p>
              <p class="formula-band__trait">演绎 ・ 约束 ・ 可确定</p>
            </div>
            <span class="formula-band__op formula-band__op--arrow" aria-hidden="true">→</span>
            <div class="formula-band__cell formula-band__cell--focus">
              <p class="formula-band__key">工程化融合与收敛</p>
              <p class="formula-band__trait">数据治理 · 工作流编排 · AI 护栏 · 人机审核</p>
            </div>
            <span class="formula-band__op formula-band__op--arrow" aria-hidden="true">→</span>
            <div class="formula-band__cell formula-band__cell--out">
              <p class="formula-band__key">确定性商业交付</p>
              <p class="formula-band__trait">稳定输出 · 可控风险 · 可验证 · 可重复</p>
            </div>
          </div>
          <p class="formula-band__note">
            确定性不来自任何一方，而来自这个分工结构：大模型负责规模化生成，规则系统负责演绎与校验，人类负责关键判断与责任闭环。
          </p>
        </div>

      </div>
    </section>

    <section class="ww-section" id="harness" aria-labelledby="solutions-harness">
      <div class="ww-section__inner">
        <header class="ww-section__head">
          <p class="ww-label">Harness · 技术底座</p>
          <h2 class="ww-section__title" id="solutions-harness">统一驾驭大模型</h2>
          <p class="ww-section__desc">
            大模型提供概率性的理解与生成，驾驭层把它制度化：规划怎么写、约束怎么建模、工具怎么调用、知识怎么注入、护栏怎么设边界、流水线怎么编排、链路怎么观测。底座之上，才是各个场景的智能体。
          </p>
        </header>

        <div class="solutions-diagram solutions-diagram--harness">
          <HarnessDiagram />
        </div>
      </div>
    </section>

    <section class="ww-section" aria-labelledby="solutions-systems">
      <div class="ww-section__inner">
        <header class="ww-section__head">
          <p class="ww-label">What · 体系 → 行业</p>
          <h2 class="ww-section__title" id="solutions-systems">方案体系</h2>
          <p class="ww-section__desc">
            每个体系是一套可复用的工程底座，下面挂着它在各个行业的具体落地方案。
          </p>
        </header>

        <figure class="solutions-diagram solutions-diagram--routing">
          <TaskRoutingDiagram />
          <figcaption>
            任务先分流，再交给对应的体系：概率性任务走<strong>工程化收敛体系</strong>（生成 + 收敛），确定性任务走规则直接求解；分流、分派与汇合由<strong>任务分流共同治理体系</strong>统一负责。
          </figcaption>
        </figure>

        <div class="solution-grid">
          {
            systems.map((system) => (
              <article class="solution-card">
                <div class="solution-card__meta">
                  <span class="solution-kind">体系</span>
                  {system.entry.data.status && (
                    <span class={`status-badge status-badge--${system.entry.data.status}`}>
                      {statusLabels[system.entry.data.status] ?? system.entry.data.status}
                    </span>
                  )}
                </div>
                <h3 class="solution-card__title">
                  <a href={system.href}>{system.entry.data.title}</a>
                </h3>
                <p class="solution-card__summary">{system.entry.data.summary}</p>
                <a class="solution-card__cta" href={system.href}>查看体系 →</a>
              </article>
            ))
          }
        </div>

        <p class="solutions-diagram__more">
          <a class="btn btn--ghost" href="/articles/probabilistic-llm-deterministic-rules/">
            阅读任务分流方法论 →
          </a>
        </p>
      </div>
    </section>

    <section class="ww-section" aria-labelledby="solutions-industries">
      <div class="ww-section__inner">
        <header class="ww-section__head">
          <p class="ww-label">Where · 行业落地</p>
          <h2 class="ww-section__title" id="solutions-industries">落地方案</h2>
          <p class="ww-section__desc">
            落地方案不是"选一套体系套上去"，而多是<strong>复合型</strong>的——同一个行业里，既有确定性任务也有概率性任务，还要治理两者的分流。因此落地方案独立成篇，按行业自己的具体矛盾组合体系与路径。
          </p>
        </header>

        <div class="industry-grid">
          {
            landings.map((landing) => {
              const involved = systemsOf(landing.entry);
              return (
                <a class="industry-card" href={landing.href}>
                  <div class="solution-card__meta">
                    <span class="solution-kind">
                      {solutionKindLabels[landing.entry.data.kind]}
                    </span>
                    {landing.entry.data.industry && (
                      <span class="cat-badge">{landing.entry.data.industry}</span>
                    )}
                    {involved.length > 1 && (
                      <span class="status-badge status-badge--preview">复合型</span>
                    )}
                  </div>
                  <h3 class="industry-card__title">{landing.entry.data.title}</h3>
                  <p class="industry-card__summary">{landing.entry.data.summary}</p>
                  {involved.length > 0 && (
                    <div class="stage-tags">
                      {involved.map((name) => (
                        <span class="stage-tag stage-tag--return">{name}</span>
                      ))}
                    </div>
                  )}
                  <span class="industry-card__cta">查看方案 →</span>
                </a>
              );
            })
          }
        </div>

        {landings.length === 0 && (
          <p class="industry-empty">落地方案正在编写中，敬请期待。</p>
        )}
      </div>
    </section>
  </div>

  <CooperationStrip
    id="solutions-cooperation"
    desc="把你的行业链路，收敛成可交付的方案 — 从一个环节开始"
  />
</ZeyoLayout>
