---
import ZeyoLayout from "../../layouts/ZeyoLayout.astro";
import ToolCard from "../../components/zeyo/ToolCard.astro";
import workshopData from "../../data/workshop.zh.json";
import type { WorkshopScene } from "../../data/workshop.types";
import "../../styles/zeyo/workshop.css";

const scenes = workshopData.scenes as WorkshopScene[];
---

<ZeyoLayout
  currentPath="/workshop/"
  title="乐乐工坊 — NeuraVoxel"
  description="乐乐工坊：开物造环，匠心成器——精益制造，接通万物闭环"
  pageClass="tools-page"
>
  <header class="page-head">
    <p class="ww-label">Lele Workshop</p>
    <h1 class="page-head__title">乐乐工坊</h1>
    <p class="page-head__desc">
      开物造环，匠心成器——以百工之乐造物，以精益求精接环，闭环上的每一断点，皆有作品与之。
    </p>
  </header>

  <section class="workshop-intro" aria-label="工坊理念">
    <div class="workshop-intro__inner">
      <div class="workshop-intro__grid">
        <article class="workshop-intro__card">
          <p class="workshop-intro__card-label">乐 · 态度</p>
          <h3 class="workshop-intro__card-title">以乐开物</h3>
          <p class="workshop-intro__card-body">
            开物本为乐事。工欲善其事，先以 Agent 利其器——重复交给机器，巧思留给人，乐而不倦。
          </p>
        </article>
        <article class="workshop-intro__card">
          <p class="workshop-intro__card-label">匠 · 精神</p>
          <h3 class="workshop-intro__card-title">匠心成器</h3>
          <p class="workshop-intro__card-body">
            匠于心，工于细。天工与人巧相济，方能成器——接口要稳、体验要顺、文档要清，经得住环上流转，也经得住时间。
          </p>
        </article>
        <article class="workshop-intro__card">
          <p class="workshop-intro__card-label">乐 · 节奏</p>
          <h3 class="workshop-intro__card-title">循序造物</h3>
          <p class="workshop-intro__card-body">
            开物不必一日而成。一坊一器，做好再上一件——快迭代，不燥进，亦不糙。
          </p>
        </article>
        <article class="workshop-intro__card">
          <p class="workshop-intro__card-label">坊 · 方法</p>
          <h3 class="workshop-intro__card-title">百工成坊</h3>
          <p class="workshop-intro__card-body">
            百工各成其坊，一器通一环。标注、训练、学习、办公——断点在哪，作品就在哪，各尽其巧。
          </p>
        </article>
      </div>
    </div>
  </section>

  <div
    class="ww-section__inner workshop-catalog"
    style="padding-inline: var(--ww-page-x); padding-bottom: 3rem;"
  >
    <header class="workshop-catalog__head">
      <h2 class="workshop-catalog__title">工坊作品目录</h2>
      <p class="workshop-catalog__desc">按场景浏览百工之作，每件作品标注它在闭环上的位置。</p>
    </header>
    <div class="filter-tabs" role="tablist" aria-label="场景筛选">
      <button class="filter-tab" role="tab" aria-selected="false" data-filter="all">全部</button>
      <button class="filter-tab" role="tab" aria-selected="true" data-filter="driving">自动驾驶</button>
      <button class="filter-tab" role="tab" aria-selected="false" data-filter="learning">教育学习</button>
      <button class="filter-tab" role="tab" aria-selected="false" data-filter="office">日常办公</button>
      <button class="filter-tab" role="tab" aria-selected="false" data-filter="career">职场求职</button>
      <button class="filter-tab" role="tab" aria-selected="false" data-filter="marketing">市场营销</button>
      <button class="filter-tab" role="tab" aria-selected="false" data-filter="more">更多场景</button>
    </div>

    {
      scenes.map((scene) => (
        <section
          class="tools-scene"
          id={scene.id}
          data-scene={scene.id}
          hidden={scene.id !== "driving"}
        >
          <header class="tools-scene__head">
            <h2 class="tools-scene__title">{scene.title}</h2>
            <span class="tools-scene__count">{scene.countLabel}</span>
            {scene.loopSteps.length > 0 && (
              <div class="tools-scene__loop" aria-hidden="true">
                {scene.loopSteps.map((step, i) => (
                  <>
                    {i > 0 && <span class="arrow">→</span>}
                    <span>{step}</span>
                  </>
                ))}
              </div>
            )}
          </header>
          {scene.empty ? (
            <div class="tools-empty">
              <p class="tools-empty__title">{scene.emptyTitle}</p>
              <p class="tools-empty__desc">{scene.emptyDesc}</p>
            </div>
          ) : (
            <div class="tool-grid">
              {scene.products.map((product) => (
                <ToolCard product={product} />
              ))}
            </div>
          )}
        </section>
      ))
    }
  </div>
</ZeyoLayout>

<script is:inline>
  (function () {
    const tabs = document.querySelectorAll(".filter-tab");
    const scenes = document.querySelectorAll(".tools-scene[data-scene]");

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const filter = tab.dataset.filter;
        tabs.forEach((t) =>
          t.setAttribute("aria-selected", t === tab ? "true" : "false"),
        );
        scenes.forEach((scene) => {
          scene.hidden = filter !== "all" && scene.dataset.scene !== filter;
        });
      });
    });
  })();
</script>
